# Server authentication mode:
#   private = Requires NUVI_TECH_KEY on nuvi-host and enables /api/devices & /api/audit.
#             If NUVI_TECH_KEY is left blank, nuvi-server auto-generates a 48-char key
#             on first boot, saves it to /data/tech.key, and prints it in `docker logs`.
#   open    = Public or personal relay. No Tech Key required; /api/devices is
#             disabled (403) and all access is gated by E2EE + Client Accept/Decline or
#             the client's rotating Unattended Key.
NUVI_AUTH_MODE=private

# Optional in private mode (leave empty to auto-generate on first start):
NUVI_TECH_KEY=
